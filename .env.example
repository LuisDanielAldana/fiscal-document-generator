APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Every date here is a SAT date, so the app runs on Mexico City time: this is
# what decides which fiscal day a document belongs to and when 02:00 falls.
APP_TIMEZONE=America/Mexico_City

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Fiscal documents are private. Keep the local driver during development.
# Use an encrypted, private S3-compatible bucket in production.
FISCAL_DOCUMENTS_DRIVER=local
# FISCAL_DOCUMENTS_ROOT=
# FISCAL_DOCUMENTS_AWS_ACCESS_KEY_ID=
# FISCAL_DOCUMENTS_AWS_SECRET_ACCESS_KEY=
# FISCAL_DOCUMENTS_AWS_DEFAULT_REGION=
# FISCAL_DOCUMENTS_AWS_BUCKET=
# FISCAL_DOCUMENTS_AWS_ENDPOINT=
# FISCAL_DOCUMENTS_AWS_USE_PATH_STYLE_ENDPOINT=false

# SAT e-signature files (.cer / .key). Its own disk so the bucket and IAM policy
# for signing material can be locked down separately from generated documents.
FISCAL_CREDENTIALS_DRIVER=local
# FISCAL_CREDENTIALS_ROOT=
# FISCAL_CREDENTIALS_AWS_ACCESS_KEY_ID=
# FISCAL_CREDENTIALS_AWS_SECRET_ACCESS_KEY=
# FISCAL_CREDENTIALS_AWS_DEFAULT_REGION=
# FISCAL_CREDENTIALS_AWS_BUCKET=
# FISCAL_CREDENTIALS_AWS_ENDPOINT=
# FISCAL_CREDENTIALS_AWS_USE_PATH_STYLE_ENDPOINT=false

# SatGo. Create the API key once from web.sat-go.com; the app exchanges it for a
# short-lived JWT on every call.
SATGO_BASE_URL=https://api.sat-go.com
SATGO_API_KEY=
SATGO_API_VERSION=v2
SATGO_TIMEOUT=120

# WhatsApp Cloud API. The webhook verify token is yours to choose; the app secret
# is what signs incoming webhooks and must match the Meta app.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_DOCUMENT_LINK_TTL=10

QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
